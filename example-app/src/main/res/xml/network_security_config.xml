<?xml version="1.0" encoding="utf-8"?>
<!--
  The SDK requires HTTPS for any real gateway. Cleartext is permitted only for
  loopback and the emulator's host alias so the sample can be pointed at a
  gateway running on the developer's machine; a production app should delete
  this file and the manifest reference with it.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
