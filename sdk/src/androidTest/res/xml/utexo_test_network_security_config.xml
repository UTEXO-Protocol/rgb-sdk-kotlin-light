<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is permitted ONLY for loopback and the emulator's host alias, so an
  instrumented test can reach a gateway running on the developer's machine.
  Everything else keeps the platform default, which rejects cleartext.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
